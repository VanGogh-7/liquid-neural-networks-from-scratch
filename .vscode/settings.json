{
  "python.defaultInterpreterPath": "/home/van-gogh/miniconda3/envs/deep_learning/bin/python",
  "python.terminal.activateEnvironment": false,
  "python.analysis.extraPaths": [
    "${workspaceFolder}/src"
  ],
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "tests"
  ],
  "python.testing.unittestEnabled": false,
  "terminal.integrated.env.linux": {
    "CONDA_DEFAULT_ENV": "deep_learning",
    "CONDA_PREFIX": "/home/van-gogh/miniconda3/envs/deep_learning",
    "PATH": "/home/van-gogh/miniconda3/envs/deep_learning/bin:${env:PATH}"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll.ruff": "explicit"
    }
  },
  "ruff.nativeServer": "on",
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/*.egg-info": true,
    "notes/**/*.aux": true,
    "notes/**/*.bbl": true,
    "notes/**/*.blg": true,
    "notes/**/*.fdb_latexmk": true,
    "notes/**/*.fls": true,
    "notes/**/*.log": true,
    "notes/**/*.out": true,
    "notes/**/*.run.xml": true,
    "notes/**/*.toc": true
  },
  "latex-workshop.latex.recipe.default": "latexmk (pdf)",
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (pdf)",
      "tools": [
        "latexmk-pdf"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-pdf",
      "command": "latexmk",
      "args": [
        "-pdf",
        "-interaction=nonstopmode",
        "-synctex=1",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.view.pdf.viewer": "tab",
  "editor.rulers": [
    100
  ],
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true
}
